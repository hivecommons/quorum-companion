{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quorum Companion",
  "version": "0.2.0",
  "identifier": "dev.hivecommons.quorum-companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quorum Companion",
        "width": 420,
        "height": 640,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Let Betty listen to your own meeting app, with consent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/quorum-capture"
    ],
    "linux": {
      "deb": {
        "depends": ["pipewire-bin", "pulseaudio-utils", "libdbus-1-3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
